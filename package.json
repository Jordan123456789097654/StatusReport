{
  "name": "statusreport",
  "version": "0.1.0",
  "private": true,
  "description": "Free, open-source, self-hostable uptime monitoring, incident management and status pages.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build.mjs",
    "start": "next start",
    "worker": "node --env-file-if-exists=.env --import tsx worker/index.ts",
    "db:prepare": "node scripts/prepare-db.mjs && prisma generate",
    "db:push": "node scripts/prepare-db.mjs && prisma db push",
    "db:seed": "node --env-file-if-exists=.env --import tsx prisma/seed.ts",
    "setup": "npm run db:push && npm run db:seed",
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/prepare-db.mjs && prisma generate",
    "serve": "node scripts/serve.mjs",
    "db:seed-status": "node --env-file-if-exists=.env --import tsx scripts/seed-status.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "lucide-react": "0.577.0",
    "next": "15.5.29",
    "nodemailer": "7.0.13",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "tsx": "4.23.15",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.5",
    "@types/nodemailer": "7.0.12",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3"
  }
}
