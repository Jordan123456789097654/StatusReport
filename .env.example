# ── Core ────────────────────────────────────────────────────────────────
# Public URL of the dashboard / landing page (what visitors type in the browser).
# For local testing use http://localhost:3000. Rebuild (npm run build) after changing it.
NEXT_PUBLIC_APP_URL=https://statusreport.roleflow.site
# Hostname customers point their CNAME records at.
CNAME_TARGET=statuspage.statusreport.roleflow.site
# Extra hostnames that should be treated as the main app (comma separated).
APP_HOSTS=
# Long random string used to sign sessions, ack links and password-gate cookies.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change-me
# Port the web server listens on.
PORT=3000

# ── Database ────────────────────────────────────────────────────────────
# SQLite (zero-config, one file on this machine). connection_limit/socket_timeout stop "database is busy" errors
# when the web app and the worker write at the same time:
# PostgreSQL / Neon: use the *pooled* connection string for DATABASE_URL and the
# *direct* (non-pooled) one for DIRECT_URL, which Prisma uses for schema changes:
#   DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15
#   DIRECT_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=file:../data/statusreport.db?connection_limit=1&socket_timeout=30
DIRECT_URL=

# ── Tenancy & safety ────────────────────────────────────────────────────
# true  = anyone can register and create free workspaces (SaaS mode)
# false = single-tenant: only the first user can register, others need an invite
SAAS_MODE=true
# Custom <head>/HTML/JS on status pages only runs on verified custom domains (separate origin).
# Set to true on a single-tenant install to also allow it on /s/{slug}.
ALLOW_CUSTOM_JS_ON_APP_HOST=false
# Stops monitors from probing private/internal addresses (localhost, 192.168.x.x, 10.x.x.x…).
# Keep this true when other people can create monitors: the worker runs on YOUR network.
BLOCK_PRIVATE_TARGETS=true
# Trust X-Forwarded-Host / X-Forwarded-For from a tunnel or reverse proxy (Cloudflare Tunnel, Caddy, nginx).
# Set to false when the app is reached directly.
TRUST_PROXY=true

# ── Worker ──────────────────────────────────────────────────────────────
# Each worker process checks from one region. Run several workers with different names.
WORKER_REGION=local
WORKER_CONCURRENCY=25
# Raw check results older than this are deleted (daily rollups are kept forever).
RETENTION_DAYS=7
# Write static snapshots of public pages to disk for "disaster mode" (always on with SQLite).
WORKER_SNAPSHOTS=false

# ── Email (optional; pick SMTP or Resend) ───────────────────────────────
EMAIL_FROM=StatusReport <alerts@statusreport.roleflow.site>
SMTP_URL=
RESEND_API_KEY=

# ── OAuth (optional) ────────────────────────────────────────────────────
# Callback URL: {NEXT_PUBLIC_APP_URL}/api/auth/oauth/{provider}/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Optional seed (npm run db:seed) ─────────────────────────────────────
SEED_EMAIL=
SEED_PASSWORD=

# ── Vercel + Neon hosting (optional) ────────────────────────────────────
# Registers customer custom domains with your Vercel project (Vercel → Settings → Tokens).
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
# Set true in Vercel's env vars to sync the schema to Neon on every deploy.
DB_PUSH_ON_BUILD=false
