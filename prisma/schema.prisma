// StatusReport database schema.
//
// One schema serves both SQLite (self-hosting) and PostgreSQL (SaaS). `scripts/prepare-db.mjs`
// rewrites the `provider` line below to match DATABASE_URL before `prisma generate`.
// To stay portable we avoid enums, scalar lists and Json columns: enum-like values are Strings
// (documented inline) and structured data is JSON text.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"] // rhel-openssl-3.0.x = Vercel / AWS Lambda
}

// The datasource block is regenerated by scripts/prepare-db.mjs from DATABASE_URL (and DIRECT_URL
// for Neon). The committed default targets PostgreSQL, the production setup.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ───────────────────────────── Identity & tenancy ─────────────────────────────

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  name          String?
  passwordHash  String?
  avatarUrl     String?
  totpSecret    String?
  totpEnabled   Boolean      @default(false)
  discordUserId String? // used for on-call @mentions in private Discord alerts
  createdAt     DateTime     @default(now())
  memberships   Membership[]
  sessions      Session[]
  accounts      Account[]
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  provider          String // github | discord | google
  providerAccountId String
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id          String   @id // sha256 of the cookie token
  userId      String
  workspaceId String?
  pending2fa  Boolean  @default(false)
  expiresAt   DateTime
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Workspace {
  id                String              @id @default(cuid())
  name              String
  slug              String              @unique
  incidentPrefix    String              @default("SR")
  incidentCounter   Int                 @default(0)
  groupingWindowSec Int                 @default(300) // cascade failures within this window share one incident
  createdAt         DateTime            @default(now())
  memberships       Membership[]
  invites           Invite[]
  apiKeys           ApiKey[]
  monitors          Monitor[]
  incidents         Incident[]
  maintenances      Maintenance[]
  channels          AlertChannel[]
  schedules         OnCallSchedule[]
  policies          EscalationPolicy[]
  statusPages       StatusPage[]
  deployments       Deployment[]
  auditLogs         AuditLog[]
  notificationLogs  NotificationLog[]
}

model Membership {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  role        String    @default("viewer") // owner | admin | responder | viewer
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

model Invite {
  id          String    @id @default(cuid())
  workspaceId String
  email       String
  role        String    @default("viewer")
  token       String    @unique
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model ApiKey {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  prefix      String // first characters shown in the UI
  hash        String    @unique // sha256 of the full key
  scopes      String    @default("read") // comma list: read, write, heartbeat, deployments
  lastUsedAt  DateTime?
  createdById String?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// ───────────────────────────── Monitoring ─────────────────────────────

model Monitor {
  id                  String    @id @default(cuid())
  workspaceId         String
  name                String
  // http | keyword | json | tcp | udp | ping | dns | ssl | domain | heartbeat
  type                String    @default("http")
  target              String    @default("") // URL, host, or host:port
  method              String    @default("GET")
  headers             String    @default("{}") // JSON object
  body                String?
  bodyType            String    @default("json") // json | form | raw
  authType            String    @default("none") // none | bearer | basic
  authValue           String? // token, or "user:pass"
  expectedStatus      String    @default("200-299") // e.g. "200-299,301"
  followRedirects     Boolean   @default(true)
  keyword             String?
  keywordMode         String    @default("present") // present | absent
  jsonPath            String? // e.g. $.status
  jsonOp              String    @default("==") // == | != | contains | > | < | exists
  jsonExpected        String?
  port                Int?
  udpPayload          String?
  dnsRecordType       String    @default("A") // A | AAAA | CNAME | MX | TXT | NS
  dnsExpected         String? // comma list of expected values (drift detection)
  sslThresholds       String    @default("30,14,7,1")
  intervalSec         Int       @default(60) // 10 | 30 | 60 | 180 | 300 | 900 | 3600
  timeoutMs           Int       @default(10000)
  regions             String    @default("local") // comma list of worker regions
  confirmations       Int       @default(2) // N consecutive failures…
  confirmRegions      Int       @default(1) // …in M regions before DOWN
  degradedThresholdMs Int?
  status              String    @default("pending") // pending | up | down | degraded | paused
  paused              Boolean   @default(false)
  inMaintenance       Boolean   @default(false)
  lastCheckedAt       DateTime?
  lastStatusChange    DateTime?
  lastError           String?
  heartbeatToken      String?   @unique
  heartbeatGraceSec   Int       @default(300)
  lastHeartbeatAt     DateTime?
  sslExpiresAt        DateTime?
  sslIssuer           String?
  domainExpiresAt     DateTime?
  lastExpiryAlertDays Int? // smallest SSL/domain threshold already alerted
  escalationPolicyId  String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  workspace        Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  escalationPolicy EscalationPolicy?     @relation(fields: [escalationPolicyId], references: [id], onDelete: SetNull)
  results          CheckResult[]
  dailyStats       DailyStat[]
  incidents        IncidentMonitor[]
  components       StatusPageComponent[]
  deployments      Deployment[]

  @@index([workspaceId])
}

model CheckResult {
  id         String   @id @default(cuid())
  monitorId  String
  region     String   @default("local")
  ok         Boolean
  status     String // up | down | degraded
  statusCode Int?
  latencyMs  Int?
  dnsMs      Int?
  tcpMs      Int?
  tlsMs      Int?
  ttfbMs     Int?
  error      String?
  snippet    String? // first bytes of the response body (private alerts only)
  resolvedIp String?
  createdAt  DateTime @default(now())
  monitor    Monitor  @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([monitorId, createdAt])
  @@index([createdAt])
}

// Rolled-up per-day statistics, updated incrementally on every check and kept forever.
model DailyStat {
  id           String  @id @default(cuid())
  monitorId    String
  day          String // YYYY-MM-DD (UTC)
  total        Int     @default(0)
  up           Int     @default(0)
  degraded     Int     @default(0)
  latencySum   Int     @default(0)
  latencyCount Int     @default(0)
  monitor      Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@unique([monitorId, day])
}

// ───────────────────────────── Incidents ─────────────────────────────

model Incident {
  id                  String            @id @default(cuid())
  workspaceId         String
  number              Int
  title               String
  status              String            @default("investigating") // investigating | identified | monitoring | resolved
  severity            String            @default("major") // degraded | partial | major | maintenance
  auto                Boolean           @default(false)
  public              Boolean           @default(true)
  cause               String?
  startedAt           DateTime          @default(now())
  acknowledgedAt      DateTime?
  acknowledgedBy      String?
  resolvedAt          DateTime?
  escalationStep      Int               @default(0)
  lastEscalatedAt     DateTime?
  postmortem          String?
  postmortemPublished Boolean           @default(false)
  createdAt           DateTime          @default(now())
  workspace           Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  monitors            IncidentMonitor[]
  updates             IncidentUpdate[]

  @@unique([workspaceId, number])
  @@index([workspaceId, startedAt])
}

model IncidentMonitor {
  id         String    @id @default(cuid())
  incidentId String
  monitorId  String
  addedAt    DateTime  @default(now())
  resolvedAt DateTime?
  incident   Incident  @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  monitor    Monitor   @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@unique([incidentId, monitorId])
}

model IncidentUpdate {
  id         String   @id @default(cuid())
  incidentId String
  status     String // investigating | identified | monitoring | resolved | maintenance | update
  message    String // Markdown
  authorId   String?
  createdAt  DateTime @default(now())
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
}

model Maintenance {
  id          String    @id @default(cuid())
  workspaceId String
  title       String
  description String    @default("")
  startsAt    DateTime
  endsAt      DateTime
  muteAlerts  Boolean   @default(true)
  status      String    @default("scheduled") // scheduled | in_progress | completed
  monitorIds  String    @default("[]") // JSON array
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// ───────────────────────────── Alerting & on-call ─────────────────────────────

model AlertChannel {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  type        String // discord | slack | telegram | teams | email | webhook
  visibility  String    @default("private") // public (community-facing) | private (internal ops)
  config      String    @default("{}") // JSON: { url, botToken, chatId, emails, secret }
  template    String? // JSON DiscordTemplate (or raw JSON body for generic webhooks)
  events      String    @default("down,up,update,maintenance,expiry") // comma list
  monitorIds  String    @default("[]") // JSON array; empty = all monitors
  enabled     Boolean   @default(true)
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model OnCallSchedule {
  id            String    @id @default(cuid())
  workspaceId   String
  name          String
  rotationHours Int       @default(168)
  startsAt      DateTime  @default(now())
  memberIds     String    @default("[]") // JSON array of user ids, rotation order
  createdAt     DateTime  @default(now())
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model EscalationPolicy {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  // JSON: [{ "delayMin": 0, "channelIds": ["…"], "scheduleId": "…" }, { "delayMin": 10, … }]
  steps       String    @default("[]")
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  monitors    Monitor[]
}

model NotificationLog {
  id          String    @id @default(cuid())
  workspaceId String
  channelId   String?
  incidentId  String?
  kind        String
  ok          Boolean
  error       String?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}

// ───────────────────────────── Status pages ─────────────────────────────

model StatusPage {
  id                 String    @id @default(cuid())
  workspaceId        String
  slug               String    @unique
  name               String
  description        String    @default("")
  logoUrl            String?
  faviconUrl         String?
  websiteUrl         String?
  theme              String    @default("betterstack-dark")
  tokens             String    @default("{}") // JSON design-token overrides
  blocks             String    @default("[]") // JSON page-builder blocks (empty = default layout)
  barConfig          String    @default("{}") // JSON { days, height, gap, radius, thresholds }
  customCss          String    @default("")
  customHead         String    @default("")
  customHeader       String    @default("")
  customFooter       String    @default("")
  showLatency        Boolean   @default(true)
  locale             String    @default("en")
  strings            String    @default("{}") // JSON UI-string overrides
  visibility         String    @default("public") // public | password | ip | team
  passwordHash       String?
  ipAllowlist        String    @default("")
  subscribersEnabled Boolean   @default(true)
  reportIssueEnabled Boolean   @default(false)
  customDomain       String?   @unique
  domainStatus       String    @default("none") // none | pending | verified | failed
  domainVerifiedAt   DateTime?
  domainCheckedAt    DateTime?
  domainError        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  workspace   Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sections    StatusPageSection[]
  components  StatusPageComponent[]
  subscribers Subscriber[]
  reports     IssueReport[]
}

model StatusPageSection {
  id           String                @id @default(cuid())
  statusPageId String
  name         String
  order        Int                   @default(0)
  collapsed    Boolean               @default(false)
  statusPage   StatusPage            @relation(fields: [statusPageId], references: [id], onDelete: Cascade)
  components   StatusPageComponent[]
}

model StatusPageComponent {
  id           String             @id @default(cuid())
  statusPageId String
  sectionId    String?
  monitorId    String
  displayName  String?
  description  String?
  order        Int                @default(0)
  showLatency  Boolean            @default(true)
  statusPage   StatusPage         @relation(fields: [statusPageId], references: [id], onDelete: Cascade)
  section      StatusPageSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  monitor      Monitor            @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@unique([statusPageId, monitorId])
}

model Subscriber {
  id           String     @id @default(cuid())
  statusPageId String
  type         String // email | webhook | discord
  target       String
  componentIds String     @default("[]") // JSON array; empty = all components
  confirmed    Boolean    @default(false)
  token        String     @unique
  createdAt    DateTime   @default(now())
  statusPage   StatusPage @relation(fields: [statusPageId], references: [id], onDelete: Cascade)

  @@unique([statusPageId, type, target])
}

model IssueReport {
  id           String     @id @default(cuid())
  statusPageId String
  componentId  String?
  message      String
  email        String?
  ipHash       String
  createdAt    DateTime   @default(now())
  statusPage   StatusPage @relation(fields: [statusPageId], references: [id], onDelete: Cascade)
}

// ───────────────────────────── Serverless support ─────────────────────────────

// Last-run timestamps for throttled background jobs (retention, …) when running on cron.
model JobState {
  key       String   @id
  lastRunAt DateTime
}

// Sliding-window rate limiting that works across serverless instances.
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
  @@index([createdAt])
}

// ───────────────────────────── Dev experience & audit ─────────────────────────────

model Deployment {
  id          String    @id @default(cuid())
  workspaceId String
  monitorId   String?
  version     String
  environment String    @default("production")
  commitSha   String?
  url         String?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  monitor     Monitor?  @relation(fields: [monitorId], references: [id], onDelete: SetNull)
}

model AuditLog {
  id          String     @id @default(cuid())
  workspaceId String?
  userId      String?
  actor       String? // email or "api-key:<name>" or "system"
  action      String // e.g. monitor.update, incident.update, domain.change, auth.login
  target      String?
  meta        String     @default("{}")
  ip          String?
  createdAt   DateTime   @default(now())
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}
